{
  "name": "komi-report-web",
  "private": true,
  "version": "5.2.12",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "start": "node server.mjs",
    "lint": "tsc --noEmit",
    "test:security": "tsx --test tests/security.test.ts",
    "test:numeric": "tsx --test tests/numeric-format.test.ts",
    "test:report-users": "tsx --test tests/report-user-rows.test.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "nanoid": "3.3.19",
    "postcss": "8.5.28",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=12.1.0 <13"
  },
  "packageManager": "npm@12.1.0",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
